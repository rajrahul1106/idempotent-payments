# Copy to .env. Never commit .env.
ENVIRONMENT=local
LOG_LEVEL=INFO

DATABASE_URL=postgresql+psycopg://payments:payments@localhost:5433/payments
DB_POOL_SIZE=20
DB_MAX_OVERFLOW=5
DB_STATEMENT_TIMEOUT_MS=5000
DB_LOCK_TIMEOUT_MS=3000

KAFKA_BOOTSTRAP_SERVERS=localhost:19092
KAFKA_MAIN_TOPIC=payments.main
KAFKA_DLQ_TOPIC=payments.dlq
KAFKA_PARTITIONS=6
KAFKA_CONSUMER_GROUP=payments-ledger
RETRY_TIER_SECONDS=5,60,600

OUTBOX_POLL_INTERVAL_MS=200
OUTBOX_BATCH_SIZE=100
OUTBOX_LISTEN_ENABLED=true

# Tracing: OTLP gRPC to Jaeger. Compose sets http://jaeger:4317 per service.
OTEL_ENABLED=true
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317
OTEL_EXPORT_TIMEOUT_SECONDS=5

RECONCILIATION_INTERVAL_SECONDS=300
RECONCILIATION_OUTBOX_WARN_SECONDS=60

# Metrics: every process except the API serves /metrics on this port.
METRICS_PORT=9100
FATAL_EXIT_LINGER_SECONDS=12
PIPELINE_GAUGES_INTERVAL_SECONDS=10

# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=dev-only-insecure-secret-change-me
JWT_ALGORITHM=HS256
JWT_EXPIRY_MINUTES=15
RATE_LIMIT_PER_MINUTE=100

IDEMPOTENCY_TTL_HOURS=24

# Test suite only. Read from the environment, not from .env; the Makefile
# exports this default. The name must end in _test or the suite refuses to
# run, so tests can never touch the database `make up` serves.
TEST_DATABASE_URL=postgresql+psycopg://payments:payments@localhost:5433/payments_test
